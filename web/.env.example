# --- n8n ---------------------------------------------------------------
# Sem N8N_BASE_URL o app usa o backend SIMULADO (src/lib/mock.ts).
# Com ele, /api/buscar → POST {N8N_BASE_URL}/webhook/buscar-imoveis
#          /api/resultados/:id → GET {N8N_BASE_URL}/webhook/resultados/:id
N8N_BASE_URL=
N8N_API_KEY=

# --- Supabase (avaliações da avaliadora) --------------------------------
# Sem estas variáveis as avaliações vão para .data/avaliacoes.json (só desenvolvimento).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Acesso restrito (opcional) -----------------------------------------
# Se os dois estiverem definidos, o site inteiro pede usuário e senha.
APP_USUARIO=
APP_SENHA=

# --- Simulação ----------------------------------------------------------
# Fontes que o backend simulado faz falhar (testar o estado de erro parcial). Ex.: kikina
MOCK_FONTES_COM_FALHA=
# 1 = usa o backend simulado mesmo com N8N_BASE_URL definido.
FORCAR_MOCK=

# --- Sugestão de avaliação por fotos (OpenRouter) -----------------------
# Modelo de visão: nunca fixo no código. Confira o id em https://openrouter.ai/api/v1/models
# (openrouter/free aceita imagens). Sem estas variáveis a análise devolve erro de configuração.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Máximo de fotos enviadas ao modelo por análise (padrão 6).
FOTOS_MAX=10
# true = grava a resposta bruta do modelo em analises_foto.resposta_bruta (só para depuração).
LOG_RESPOSTA_BRUTA=false

# --- Triagem com o Jev (TypeSafe), depois da análise de fotos -------------
# Só no servidor. Sem a chave, a triagem fica "indisponível" e o caso vai para revisão humana obrigatória.
TYPESAFE_API_KEY=
# Use o id versionado em produção (não "jev-latest").
JEV_MODEL=jev-1.13.0
# Opcional: gateway. Vazio = padrão do SDK (https://api.typesafe.ai).
JEV_BASE_URL=
# Probabilidade de "precisa de revisão" acima disto → revisão obrigatória.
JEV_LIMITE_REVISAO=0.5
# Probabilidade de "justificativa coerente" abaixo disto → revisão obrigatória.
JEV_LIMITE_COERENCIA=0.5
# Nota de coerência (1 a 5) abaixo disto → revisão obrigatória.
JEV_NOTA_MINIMA=3
# Timeout por tentativa, em ms (há 1 nova tentativa em timeout/429/5xx).
JEV_TIMEOUT_MS=20000
