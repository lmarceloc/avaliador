# Postgres (no EasyPanel: a Internal Connection URL do serviço Postgres)
DATABASE_URL=
# Chave que o site manda no header X-API-Key (mínimo 24 caracteres). Use a mesma em BACKEND_API_KEY na Vercel.
API_KEY=
PORT=3000
# Horas que o resultado de uma busca serve de cache para todas as empresas (1 a 168; padrão 24).
# O botão "Atualizar" do site ignora o cache e coleta de novo.
CACHE_BUSCAS_HORAS=24
