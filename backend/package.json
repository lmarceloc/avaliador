{
  "name": "avaliador-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coleta das imobiliárias e banco Postgres do avaliador (roda na VPS, no lugar do n8n e do Supabase).",
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/servidor.mjs",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "testar-coleta": "tsx scripts/testar-coleta.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
